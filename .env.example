# Copy this file to .env and fill in local credentials. Never commit .env.

# OpenAI-compatible LLM endpoint.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://example.com/v1"
OPENAI_MODEL="your-model"
OPENAI_MAX_ATTEMPTS=3
EMBODICHAIN_LLM_PROXY=""

# Use the remote Scene Engine profile. This skips local SAM3/SAM3D startup.
SCENESMITH_GEOMETRY_MODE="remote"
SCENESMITH_GEOMETRY_BACKEND="remote"
SCENESMITH_IMAGE_GENERATION_BACKEND="scene_engine"
SCENESMITH_ENABLE_ARTICULATED="false"
SCENESMITH_ENABLE_THIN_COVERING="false"
SCENESMITH_USE_MATERIALS_RETRIEVAL="false"
# Disable when user namespaces/device re-binding are unavailable. Shared GPU
# access is sufficient for the basic single-worker profile.
SCENESMITH_DISABLE_BWRAP="true"
# Use json_object for compatible providers that reject Responses JSON Schema.
SCENESMITH_OPENAI_STRUCTURED_OUTPUT_MODE="json_object"
# Chat Completions supports native tool calls on the current compatible provider.
SCENESMITH_OPENAI_API_MODE="chat_completions"
# Do not send Agents SDK traces to the official OpenAI tracing endpoint.
OPENAI_AGENTS_DISABLE_TRACING="true"

SCENE_ENGINE_OPENAI_DEFAULT_QUERY="{}"
SCENE_ENGINE_IMAGE_SEGMENTATION_BASE_URL="http://127.0.0.1:8685"
SCENE_ENGINE_IMAGE_SEGMENTATION_TIMEOUT_S=30
SCENE_ENGINE_IMAGE_SEGMENTATION_MAX_ATTEMPTS=3
SCENE_ENGINE_IMAGE_SEGMENTATION_HEALTH_PATH="/health"
SCENE_ENGINE_IMAGE_SEGMENTATION_BY_PROMPT_PATH="/segment_by_prompt"

SCENE_ENGINE_IMAGE_GENERATION_BASE_URL="http://127.0.0.1:8687"
SCENE_ENGINE_IMAGE_GENERATION_TIMEOUT_S=120
SCENE_ENGINE_IMAGE_GENERATION_MAX_ATTEMPTS=3
SCENE_ENGINE_IMAGE_GENERATION_HEALTH_PATH="/health"
SCENE_ENGINE_IMAGE_GENERATION_BY_PROMPT_PATH="/generate_image_by_prompt"

SCENE_ENGINE_GEOMETRY_GENERATION_BASE_URL="http://127.0.0.1:8686"
SCENE_ENGINE_GEOMETRY_GENERATION_TIMEOUT_S=600
SCENE_ENGINE_GEOMETRY_GENERATION_MAX_ATTEMPTS=3
SCENE_ENGINE_GEOMETRY_GENERATION_HEALTH_PATH="/health"
SCENE_ENGINE_GEOMETRY_GENERATION_OBJECTS_PATH="/generate_multiple_objects"

# Reserved for a future Articraft integration; disabled in the basic profile above.
ARTICULATION_SERVER_BASE_URL=""

GRADIO_SERVER_NAME="127.0.0.1"
GRADIO_SERVER_PORT=7860
SCENE_ENGINE_VISER_PORT=8080
ARTICRAFT_VISER_PORT=8081
